# E2E build for the basemap choice tests (npm run build:e2e-basemap → dist-basemap/).
# Not a real key: the tests stub the Esri styles service (tests/e2e/support/basemapStub.ts).
# Mode-specific, so it overrides any real key in .env.local for this build only.
VITE_ARCGIS_API_KEY=e2e-stub-not-a-key
VITE_ARCGIS_ASSETS=local
