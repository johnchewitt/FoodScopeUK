{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/config.schema.json",
  "title": "AppConfig",
  "description": "Runtime configuration loaded from public/config.json. Public values only — never secrets (ADR-11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "featureFlags", "hostedLayers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "featureFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globe3d"],
      "properties": {
        "globe3d": { "type": "boolean", "description": "3D globe mode (Release 2)." }
      }
    },
    "hostedLayers": {
      "type": "object",
      "description": "Optional ArcGIS FeatureLayer overrides keyed by dataset id (ADR-08).",
      "additionalProperties": { "$ref": "#/definitions/HostedLayer" }
    }
  },
  "definitions": {
    "HostedLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "fieldMap": {
          "type": "object",
          "description": "Maps canonical schema field names to the hosted layer's field names.",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
