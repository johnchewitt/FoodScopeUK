{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/lad-boundaries.schema.json",
  "title": "CouncilBoundaries",
  "description": "May 2025 council boundaries for display (S14, BGC edition clipped to the coastline), simplified as a coverage and published in WGS84 (EPSG:4326). Written by `foodscope-pipeline build-local`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": { "type": "array", "items": { "$ref": "#/definitions/CouncilFeature" } }
  },
  "definitions": {
    "Position": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "Ring": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/Position" } },
    "PolygonCoordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Ring" } },
    "CouncilFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "Polygon" },
                "coordinates": { "$ref": "#/definitions/PolygonCoordinates" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "MultiPolygon" },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/definitions/PolygonCoordinates" }
                }
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "name", "nameWelsh", "nation"],
          "properties": {
            "code": { "type": "string", "pattern": "^[EWSN]\\d{8}$", "description": "LAD25CD" },
            "name": { "type": "string", "description": "LAD25NM" },
            "nameWelsh": { "type": ["string", "null"], "description": "LAD25NMW (Welsh councils only)" },
            "nation": { "$ref": "#/definitions/Nation" }
          }
        }
      }
    },
    "Nation": { "type": "string", "enum": ["England", "Wales", "Scotland", "Northern Ireland"] }
  }
}
