{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/lad-indicators.schema.json",
  "title": "CouncilIndicators",
  "description": "Per May 2025 council: mid-2025 population and land area (S18) and GEOLYTIX store counts by size band and format (S11, assigned on S14 boundaries). Ratios such as stores per 10,000 residents are computed in the app (src/analysis, spec §6.3). Written by `foodscope-pipeline build-local`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "population", "landArea", "stores", "councils", "outsideCouncils"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "label", "referenceDate", "boundaries"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^S\\d{2}$" },
        "label": { "type": "string", "description": "e.g. mid-2025" },
        "referenceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "boundaries": { "type": "string" }
      }
    },
    "landArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "definition"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^S\\d{2}$" },
        "definition": { "type": "string" }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "edition", "sizeBands", "storeClasses", "formats", "groups"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^S\\d{2}$" },
        "edition": { "type": "string" },
        "sizeBands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "value", "storeClass"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "value": { "type": "string", "description": "GEOLYTIX size_band as delivered" },
              "storeClass": { "type": "string" }
            }
          }
        },
        "storeClasses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": { "id": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "inDefaultView", "fascias"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "inDefaultView": { "type": "boolean" },
              "fascias": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "groups": {
          "description": "Columns of each council's `stores` array: every size band × format pair.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sizeBand", "format"],
            "properties": { "sizeBand": { "type": "string" }, "format": { "type": "string" } }
          }
        }
      }
    },
    "councils": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "nation", "population", "landAreaKm2", "note", "stores"],
        "properties": {
          "code": { "type": "string", "pattern": "^[EWSN]\\d{8}$" },
          "name": { "type": "string" },
          "nation": { "type": "string", "enum": ["England", "Wales", "Scotland", "Northern Ireland"] },
          "population": { "type": ["integer", "null"], "minimum": 0 },
          "landAreaKm2": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "note": {
            "type": ["string", "null"],
            "description": "Comparability note for this council (for example a boundary change after the population estimate)"
          },
          "stores": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "outsideCouncils": {
      "type": "array",
      "description": "Stores in the delivered file that no UK council holds, by reason.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "stores"],
        "properties": { "reason": { "type": "string" }, "stores": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
