{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/trade-index.schema.json",
  "title": "TradeIndex",
  "description": "Commodity baskets available in a trade snapshot (Food Origins explorer).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "commodities"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "commodities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "datasetId", "label", "definition", "hsScope", "path", "months"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "datasetId": { "type": "string", "pattern": "^trade\\.[a-z0-9_-]+$" },
          "label": { "type": "string" },
          "definition": { "type": "string" },
          "hsScope": { "type": "string" },
          "path": { "type": "string" },
          "months": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "last", "provisionalFrom"],
            "properties": {
              "first": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
              "last": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
              "provisionalFrom": { "type": ["string", "null"], "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" }
            }
          }
        }
      }
    }
  }
}
