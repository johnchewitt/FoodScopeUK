{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/council-ppfi.schema.json",
  "title": "CouncilPpfi",
  "description": "Priority Places for Food Index v2.1 (S13) by council: for each May 2025 council, the number of its small areas and how many fall in their nation's highest-priority deciles (1-2), for the combined index and each domain (null where the domain has no data in that nation), plus the combined decile counts. Small areas assigned with S15 (England, Wales), S32 (Scotland, 2011 Data Zones) and S19 NIMDM 2017 (Northern Ireland). Shares and within-nation ranks are computed in the app. Written by `foodscope-pipeline build-risk`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "index", "measures", "nations", "councils"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sourceId",
        "orientation",
        "priorityDeciles",
        "measure",
        "comparability",
        "domainsWithoutDataNote"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sourceId": {
          "const": "S13"
        },
        "orientation": {
          "type": "string"
        },
        "priorityDeciles": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "measure": {
          "type": "string"
        },
        "comparability": {
          "type": "string"
        },
        "domainsWithoutDataNote": {
          "type": ["string", "null"]
        }
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "nations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nation",
          "councils",
          "areas",
          "areaType",
          "assignment",
          "priorityAreas",
          "domainsWithoutData"
        ],
        "properties": {
          "nation": {
            "enum": ["England", "Wales", "Scotland", "Northern Ireland"]
          },
          "councils": {
            "type": "integer"
          },
          "areas": {
            "type": "integer"
          },
          "areaType": {
            "type": "string"
          },
          "assignment": {
            "type": "string"
          },
          "priorityAreas": {
            "type": "integer"
          },
          "domainsWithoutData": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "councils": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "nation", "areas", "combinedDeciles", "values"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[ENSW]\\d{8}$"
          },
          "name": {
            "type": "string"
          },
          "nation": {
            "enum": ["England", "Wales", "Scotland", "Northern Ireland"]
          },
          "areas": {
            "type": "integer",
            "minimum": 1
          },
          "combinedDeciles": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["priority", "areas"],
                  "properties": {
                    "priority": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "areas": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
