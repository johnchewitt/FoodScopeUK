{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/small-areas.schema.json",
  "title": "SmallAreaBoundaries",
  "description": "Small areas of the deep profiles (LP-06), WGS84 (EPSG:4326): Manchester's LSOAs (2021, ONS BGC V5, S15), Belfast's Data Zones (2021, NISRA, S16) and Belfast's Super Output Areas (2011, NISRA, S19; the geography of NIMDM 2017). Coverage-simplified per kind. Written by `foodscope-pipeline build-areas`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SmallAreaFeature"
      }
    }
  },
  "definitions": {
    "Position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "Ring": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/Position"
      }
    },
    "PolygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Ring"
      }
    },
    "SmallAreaFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "coordinates"],
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "$ref": "#/definitions/PolygonCoordinates"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "coordinates"],
              "properties": {
                "type": {
                  "const": "MultiPolygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/PolygonCoordinates"
                  }
                }
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "kind", "lad"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^(E01\\d{6}|W01\\d{6}|N20\\d{6}|95[A-Z]{2}\\d{2}[A-Z0-9]{2,4})$",
              "description": "LSOA21CD, DZ2021_cd or SOA 2011 code"
            },
            "kind": {
              "type": "string",
              "enum": ["lsoa21", "dz21", "soa2011"]
            },
            "lad": {
              "type": "string",
              "pattern": "^[ENSW]\\d{8}$",
              "description": "May 2025 council code"
            }
          }
        }
      }
    }
  }
}
