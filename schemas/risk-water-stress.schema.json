{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/risk-water-stress.schema.json",
  "title": "RiskWaterStress",
  "description": "Level of water stress by country (SDG 6.4.2; FAO AQUASTAT through the World Bank API, S30) with FAO's stress classes. A national figure for the whole country. Countries without any value are listed in `missing`. Written by `foodscope-pipeline build-risk`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "indicator", "countries", "missing"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "unit",
        "sdg",
        "sourceId",
        "source",
        "lastUpdated",
        "classSource",
        "classRule",
        "classes",
        "scope"
      ],
      "properties": {
        "id": {
          "const": "ER.H2O.FWST.ZS"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "const": "%"
        },
        "sdg": {
          "const": "6.4.2"
        },
        "sourceId": {
          "const": "S30"
        },
        "source": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "classSource": {
          "type": "string"
        },
        "classRule": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "min", "max"],
            "properties": {
              "id": {
                "enum": ["none", "low", "medium", "high", "critical"]
              },
              "label": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": ["number", "null"]
              }
            }
          }
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iso2", "iso3", "name", "year", "value", "class", "series"],
        "properties": {
          "iso2": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2}$"
          },
          "iso3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 2000
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "class": {
            "enum": ["none", "low", "medium", "high", "critical"]
          },
          "series": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                {
                  "type": "integer"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iso2", "iso3", "name"],
        "properties": {
          "iso2": {
            "type": "string"
          },
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
