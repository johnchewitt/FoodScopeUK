{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://johnchewitt.github.io/FoodScopeUK/schemas/trade-snapshot.schema.json",
  "title": "TradeSnapshot",
  "description": "Recorded UK imports for one commodity basket by month and recorded import partner (HMRC OTS, S01). Written by the pipeline's build-trade step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "commodity",
    "flows",
    "months",
    "units",
    "partners",
    "rows",
    "suppressed",
    "nilMonths"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^trade\\.[a-z0-9_-]+$" },
    "commodity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "definition", "hsScope", "cn8"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "label": { "type": "string" },
        "definition": { "type": "string" },
        "hsScope": { "type": "string" },
        "cn8": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "commodityId", "description"],
            "properties": {
              "code": { "type": "string", "pattern": "^\\d{8}$" },
              "commodityId": { "type": "integer" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": { "id": { "type": "integer" }, "label": { "type": "string" } }
      }
    },
    "months": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last", "provisionalFrom"],
      "properties": {
        "first": { "$ref": "#/definitions/Month" },
        "last": { "$ref": "#/definitions/Month" },
        "provisionalFrom": {
          "description": "First month still inside HMRC's 18-month revision window (estimated), or null.",
          "oneOf": [{ "$ref": "#/definitions/Month" }, { "type": "null" }]
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mass", "value"],
      "properties": {
        "mass": { "type": "string", "const": "kg" },
        "value": { "type": "string", "const": "GBP" }
      }
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "hmrcNames", "hmrcCountryIds", "kind", "iso2", "geometry", "point"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "hmrcNames": { "type": "array", "items": { "type": "string" } },
          "hmrcCountryIds": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
          "kind": {
            "type": "string",
            "enum": ["country", "unallocated"],
            "description": "unallocated = HMRC categories that are not a country (stores and provisions, estimates, confidential, regions not specified)."
          },
          "iso2": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
          "geometry": { "type": "string", "enum": ["polygon", "point", "none"] },
          "point": {
            "oneOf": [
              { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "rows": {
      "description": "[monthIndex, partnerIndex, netMassKg, valueGbp]: unsuppressed trade summed over flows and CN8 codes. monthIndex counts from months.first.",
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "suppressed": {
      "description": "[monthIndex, suppressionIndex, netMassKg | null, valueGbp | null]: trade HMRC suppresses at country level. null = not published at that suppression level.",
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": ["integer", "null"] }
      }
    },
    "nilMonths": {
      "description": "Published months (indexes) with no recorded import rows for this basket.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    }
  },
  "definitions": {
    "Month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" }
  }
}
