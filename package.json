{
  "name": "foodscope-uk",
  "private": true,
  "version": "0.1.0",
  "description": "FOODSCOPE UK — food security and supply chain intelligence demonstrator (ConsultingWhere)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:e2e-basemap": "vite build --outDir dist-basemap --emptyOutDir --mode e2e-basemap",
    "gen:types": "node scripts/gen-types.mjs",
    "build:reference": "node scripts/build-reference-layers.mjs",
    "check:banned": "node scripts/check-banned-imports.mjs"
  },
  "dependencies": {
    "@arcgis/common-components": "5.1.27",
    "@arcgis/core": "5.1.27",
    "@arcgis/map-components": "5.1.27",
    "@esri/calcite-components": "5.1.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "ajv": "8.20.0",
    "echarts": "6.1.0",
    "lucide-react": "1.61.0",
    "pdfmake": "0.3.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.5"
  }
}
