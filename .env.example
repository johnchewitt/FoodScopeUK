# Copy to .env.local for local development. .env.local is git-ignored — never commit a key.

# Vite base path. Must match the GitHub Pages path (case-sensitive). Use "/" for a custom domain.
BASE_PATH=/FoodScopeUK/

# ArcGIS API key (Basemap styles service only, referrer-restricted).
# See docs/setup/arcgis-api-key.md. Leave empty to use the offline fallback map.
VITE_ARCGIS_API_KEY=

# Where ArcGIS / Calcite runtime assets load from: "cdn" (default, Esri CDN) or "local"
# (copied into the build — use for offline or sandboxed testing).
VITE_ARCGIS_ASSETS=cdn
